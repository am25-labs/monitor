{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AM25 Monitor JSON export v1",
  "description": "Stored database rows. Numeric timestamps are Unix seconds; date buckets use UTC. Encrypted values remain encrypted.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "appVersion",
    "startedAt",
    "scope",
    "consistency",
    "credentials",
    "schema",
    "data",
    "completedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "am25-monitor"
    },
    "formatVersion": {
      "const": 1
    },
    "appVersion": {
      "type": "string"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "full"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "projectIds"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "projects"
            },
            "projectIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "period": {
              "description": "Optional UTC reporting period, start inclusive and end exclusive. Period exports cannot be restored as backups.",
              "type": "object",
              "required": ["type", "year", "timeZone", "start", "end"],
              "additionalProperties": false,
              "properties": {
                "type": { "enum": ["month", "year"] },
                "year": { "type": "integer", "minimum": 1970, "maximum": 9998 },
                "month": { "type": "integer", "minimum": 1, "maximum": 12 },
                "timeZone": { "const": "UTC" },
                "start": { "type": "string", "format": "date-time" },
                "end": { "type": "string", "format": "date-time" }
              },
              "if": { "properties": { "type": { "const": "month" } } },
              "then": { "required": ["month"] },
              "else": { "not": { "required": ["month"] } }
            }
          }
        }
      ]
    },
    "consistency": {
      "const": "live"
    },
    "credentials": {
      "const": "encrypted-with-original-CONFIG_KEY"
    },
    "schema": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "name",
          "tbl_name",
          "sql"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tbl_name": {
            "type": "string"
          },
          "sql": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object"
    },
    "completedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "type": {
                "const": "full"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/fullData"
          }
        }
      },
      "else": {
        "properties": {
          "data": {
            "$ref": "#/$defs/projectData"
          }
        }
      }
    }
  ],
