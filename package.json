{
  "name": "am25-monitor",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "about:licenses": "node scripts/maintenance/generate-third-party-notices.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "dev:worker": "wrangler dev --config wrangler.local.jsonc --local --test-scheduled",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "typegen": "wrangler types --config wrangler.local.jsonc --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test tests/deploy.test.mjs tests/migrations.test.mjs",
    "check": "pnpm typecheck && pnpm test",
    "build": "vite build",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.3",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11",
    "@base-ui/react": "^1.0.0",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2",
    "react-email": "6.11.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.145.0",
    "@cloudflare/vitest-plugin": "^1.4.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "license": "Apache-2.0",
  "author": "AM25",
  "repository": {
    "type": "git",
    "url": "https://github.com/am25-labs/monitor.git"
  }
}
