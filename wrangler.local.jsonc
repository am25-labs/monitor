{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am25-monitor-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ACCESS_TEAM_DOMAIN": "https://my-team.cloudflareaccess.com",
    "ACCESS_AUDIENCES": "",
    "ACCESS_EMAIL": "owner@example.test",
    "APP_ORIGIN": "http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monitor-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CHECKS",
        "queue": "monitor-checks-local"
      }
    ],
    "consumers": [
      {
        "queue": "monitor-checks-local",
        "max_batch_size": 5,
        "max_batch_timeout": 0,
        "max_concurrency": 20,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SCHEDULER",
        "class_name": "MonitorScheduler"
      },
      {
        "name": "CHECK_RUNNERS",
        "class_name": "MonitorRunner"
      }
    ]
  },
  "migrations": [
    {
      "tag": "scheduler-1",
      "new_sqlite_classes": [
        "MonitorScheduler"
      ]
    },
    {
      "tag": "runners-1",
      "new_sqlite_classes": [
        "MonitorRunner"
      ]
    }
  ]
}
