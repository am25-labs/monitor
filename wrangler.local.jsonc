{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am25-monitor-local",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ENVIRONMENT": "local",
    "ACCESS_TEAM_DOMAIN": "https://my-team.cloudflareaccess.com",
    "ACCESS_AUDIENCES": "",
    "ACCESS_EMAIL": "owner@example.test",
    "APP_ORIGIN": "http://localhost:5173",
    "OWNER_EMAIL": "owner@example.test",
    "POSTMARK_FROM": "monitor@example.test",
    "POSTMARK_STREAM": "outbound"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "monitor-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CHECKS",
        "queue": "monitor-checks-local"
      }
    ],
    "consumers": [
      {
        "queue": "monitor-checks-local",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_concurrency": 5,
        "max_retries": 3
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
