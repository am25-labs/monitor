{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "am25-monitor",
  "account_id": "00000000000000000000000000000000",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "secrets": {
    "required": [
      "CONFIG_KEY"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "monitor.example.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "https://my-team.cloudflareaccess.com",
    "ACCESS_AUDIENCES": "REPLACE_WITH_ACCESS_AUDIENCE",
    "ACCESS_EMAIL": "owner@example.com",
    "APP_ORIGIN": "https://monitor.example.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "am25-monitor",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "CHECKS",
        "queue": "am25-monitor-checks"
      }
    ],
    "consumers": [
      {
        "queue": "am25-monitor-checks",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_concurrency": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
